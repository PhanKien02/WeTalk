PORT=8085

# Cloudflare R2 (Dashboard → R2 → Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wetalk
# Public base URL of the bucket: r2.dev subdomain or a custom domain
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Optional: override the endpoint (e.g. local MinIO http://localhost:9000)
# R2_ENDPOINT=

UPLOAD_MAX_SIZE_MB=10
